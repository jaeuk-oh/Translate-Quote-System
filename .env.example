# ─────────────────────────────────────────────
# 번역 플랫폼 환경 변수
# 실제 값은 .env 파일에 작성 (절대 커밋 금지)
# ─────────────────────────────────────────────

# ── 필수 ──────────────────────────────────────
# 같은 Supabase 프로젝트지만 용도가 다름:
#   DATABASE_URL    → SQLAlchemy/asyncpg가 PostgreSQL에 직접 연결 (ORM, 마이그레이션)
#                     Supabase 대시보드 > Settings > Database > Connection string (Mode: asyncpg)
#   SUPABASE_URL    → supabase-py가 REST API로 연결 (Storage 파일 업로드)
#   SERVICE_KEY     → Supabase 대시보드 > Settings > API > service_role key
DATABASE_URL=postgresql+asyncpg://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

RESEND_API_KEY=re_your_resend_api_key

RESEND_API_KEY=re_your_resend_api_key

# ── 선택 (기본값으로 로컬 실행 가능) ──────────
REDIS_URL=redis://localhost:6379/0
EMAIL_FROM=noreply@yourdomain.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
DEBUG=true
